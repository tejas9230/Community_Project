# ================================================
# Project K — Environment Variables Template
# Copy this file to .env and fill in your values
# ================================================

# ── Flask ──────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key_32chars

# ── Database (leave blank to use SQLite locally) ──
# Get from: Supabase → Settings → Database → URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres

# ── Cloudinary (leave blank to save images locally) ──
# Get from: Cloudinary Dashboard → API Keys
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# ── Email Notifications (optional) ──────────────
# Use Gmail App Password (not your real password)
# Gmail → Security → 2FA → App Passwords → Generate
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
